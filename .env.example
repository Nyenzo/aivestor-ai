# AI Service Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# API Keys (REQUIRED)
# ============================================

# Alpha Vantage API Key
# Get yours at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day, 5 requests/minute
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# FRED API Key (Federal Reserve Economic Data)
# Get yours at: https://fred.stlouisfed.org/docs/api/api_key.html
# Free tier: Unlimited requests
FRED_API_KEY=your_fred_api_key_here

# News API Key
# Get yours at: https://newsapi.org/register
# Free tier: 100 requests/day
NEWSAPI_KEY=your_newsapi_key_here

# ============================================
# JWT Configuration (REQUIRED)
# ============================================

# JWT Secret Key - MUST match backend JWT_SECRET
# Generate a strong secret: openssl rand -base64 32
# IMPORTANT: Keep this secret and never commit to git!
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long-12345

# ============================================
# Server Configuration
# ============================================

# Flask Environment (development, production, testing)
FLASK_ENV=development

# Enable/disable debug mode (1 = enabled, 0 = disabled)
# WARNING: Never enable debug in production!
FLASK_DEBUG=1

# Server host (0.0.0.0 allows external connections)
HOST=0.0.0.0

# Server port
PORT=5001

# ============================================
# Logging Configuration
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=aivestor.log

# Maximum log file size (in bytes)
# 10485760 = 10MB
LOG_MAX_SIZE=10485760

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================
# Data Collection Configuration
# ============================================

# Cache expiration time (in hours)
# Data older than this will be refetched
CACHE_EXPIRATION_HOURS=24

# Default stock data lookback period (in years)
DATA_LOOKBACK_YEARS=5

# Maximum number of retries for API calls
MAX_API_RETRIES=3

# Delay between retries (in seconds)
RETRY_DELAY_SECONDS=5

# ============================================
# Model Configuration
# ============================================

# Model directory path
MODEL_DIR=models

# Data directory path
DATA_DIR=datacollection

# Number of estimators for Gradient Boosting
N_ESTIMATORS=100

# Random seed for reproducibility
RANDOM_STATE=42

# Cross-validation folds
CV_FOLDS=3

# ============================================
# Prediction Configuration
# ============================================

# Short-term prediction window (in days)
SHORT_TERM_DAYS=63

# Long-term prediction window (in days)
LONG_TERM_DAYS=252

# Historical VIX fallback value
HISTORICAL_VIX=20.0

# ============================================
# Notes
# ============================================

# 1. Never commit the actual .env file to git
# 2. Keep your API keys secret and secure
# 3. Use different JWT secrets for development and production
# 4. Monitor your API usage to avoid hitting rate limits
# 5. Back up your trained models regularly
